<Window x:Class="Donut.ShortcutSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Donut"
        Width="430"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FDFDFC"
        ShowInTaskbar="True">
  <Border Padding="28" CornerRadius="18" BorderBrush="#E8E8E6" BorderThickness="1">
    <StackPanel>
      <TextBlock Text="Set up your Donut shortcut"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="#202124"/>
      <TextBlock Text="Donut will run quietly in the background. Press this shortcut anytime to open the drop window."
                 TextWrapping="Wrap"
                 Foreground="#77797D"
                 Margin="0,10,0,0"/>
      <Border Margin="0,24,0,0"
              Padding="16"
              Background="#FAF7F4"
              BorderBrush="#F0E5DE"
              BorderThickness="1"
              CornerRadius="12">
        <StackPanel>
          <TextBlock Text="YOUR SHORTCUT"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="#D96B3B"/>
          <TextBlock x:Name="ShortcutText"
                     Text="Press a key combination…"
                     FontSize="19"
                     FontWeight="SemiBold"
                     Foreground="#202124"
                     Margin="0,7,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Use at least one modifier: Ctrl, Alt, Shift, or Win."
                 FontSize="11"
                 Foreground="#999A9C"
                 Margin="0,12,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button Content="Use Ctrl + Alt + D"
                Padding="14,8"
                Margin="0,0,10,0"
                Click="Default_Click"/>
        <Button Content="Save shortcut"
                Padding="18,8"
                Background="#D96B3B"
                Foreground="White"
                BorderThickness="0"
                Click="Save_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
